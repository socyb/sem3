  /* ── El hallazgo ── */
  hallazgo [ pos="820,190!", fillcolor="#fbe3e7", color="#c1123f", penwidth=2.5, margin="0.24,0.20", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD FIXEDSIZE="TRUE" WIDTH="620" HEIGHT="1"></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="IBM Plex Mono" POINT-SIZE="11" COLOR="#c1123f"><B>EL PUNTO CIEGO DEL RADAR</B></FONT></TD></TR><TR><TD HEIGHT="10">&#8202;</TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Fraunces" POINT-SIZE="19" COLOR="#16202c"><B>Lo que seguimos es software. Lo que traemos en la mano es materia.</B></FONT></TD></TR><TR><TD HEIGHT="4">&#8202;</TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Space Grotesk" POINT-SIZE="14" COLOR="#33415a">&#8202;</FONT></TD></TR><TR><TD HEIGHT="4">&#8202;</TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Space Grotesk" POINT-SIZE="14" COLOR="#33415a">32 de nuestros 39 radares apuntan a la inteligencia artificial. Y 32 de los 37 objetos que</FONT></TD></TR><TR><TD HEIGHT="4">&#8202;</TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Space Grotesk" POINT-SIZE="14" COLOR="#33415a">dijimos usar todos los días son aparatos: un celular, unos audífonos, una laptop, un reloj.</FONT></TD></TR><TR><TD HEIGHT="4">&#8202;</TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Space Grotesk" POINT-SIZE="14" COLOR="#33415a">Están hechos de aluminio, vidrio, plástico, litio, cobre, coltán y silicio, y alguien los arma</FONT></TD></TR><TR><TD HEIGHT="4">&#8202;</TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Space Grotesk" POINT-SIZE="14" COLOR="#33415a">en algún lugar. Ese sector —electrónica, química, manufactura— lo seguimos 3 de 39.</FONT></TD></TR><TR><TD HEIGHT="4">&#8202;</TD></TR></TABLE>> ];

  /* ── Leyenda ── */
  leyenda [ pos="820,1660!", shape="plaintext", style="", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD ALIGN="CENTER"><FONT FACE="IBM Plex Mono" POINT-SIZE="11" COLOR="#6a7789">CADA CIFRA ES CUÁNTOS DE NOSOTROS ESCRIBIMOS ESO · PUNTEADO: LO QUE CASI NADIE MIRA · EN ROJO: EL HUECO</FONT></TD></TR></TABLE>> ];
