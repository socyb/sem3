  materiales [ pos="820,540!", fillcolor="#fffcf6", penwidth=2, margin="0.20,0.16", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD FIXEDSIZE="TRUE" WIDTH="560" HEIGHT="1"></TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="IBM Plex Mono" POINT-SIZE="11" COLOR="#c8860a"><B>Y DE QUÉ ESTÁ HECHO</B></FONT></TD></TR><TR><TD HEIGHT="10">&#8202;</TD></TR><TR><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD BGCOLOR="#fbeed2" ALIGN="CENTER" CELLPADDING="5"><FONT FACE="Space Grotesk" POINT-SIZE="12" COLOR="#16202c">«Componentes electrónicos»</FONT> <FONT FACE="Fraunces" POINT-SIZE="13" COLOR="#c8860a"><B>12</B></FONT></TD><TD WIDTH="7">&#8202;</TD><TD BGCOLOR="#fbeed2" ALIGN="CENTER" CELLPADDING="5"><FONT FACE="Space Grotesk" POINT-SIZE="12" COLOR="#16202c">Aluminio</FONT> <FONT FACE="Fraunces" POINT-SIZE="13" COLOR="#c8860a"><B>7</B></FONT></TD><TD WIDTH="7">&#8202;</TD><TD BGCOLOR="#fbeed2" ALIGN="CENTER" CELLPADDING="5"><FONT FACE="Space Grotesk" POINT-SIZE="12" COLOR="#16202c">Plástico</FONT> <FONT FACE="Fraunces" POINT-SIZE="13" COLOR="#c8860a"><B>7</B></FONT></TD><TD WIDTH="7">&#8202;</TD><TD BGCOLOR="#fbeed2" ALIGN="CENTER" CELLPADDING="5"><FONT FACE="Space Grotesk" POINT-SIZE="12" COLOR="#16202c">Vidrio</FONT> <FONT FACE="Fraunces" POINT-SIZE="13" COLOR="#c8860a"><B>3</B></FONT></TD><TD WIDTH="7">&#8202;</TD><TD BGCOLOR="#fbeed2" ALIGN="CENTER" CELLPADDING="5"><FONT FACE="Space Grotesk" POINT-SIZE="12" COLOR="#16202c">Silicio</FONT> <FONT FACE="Fraunces" POINT-SIZE="13" COLOR="#c8860a"><B>2</B></FONT></TD><TD WIDTH="7">&#8202;</TD></TR></TABLE></TD></TR><TR><TD HEIGHT="6">&#8202;</TD></TR><TR><TD><TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD BGCOLOR="#fbeed2" ALIGN="CENTER" CELLPADDING="5"><FONT FACE="Space Grotesk" POINT-SIZE="12" COLOR="#16202c">Coltán</FONT> <FONT FACE="Fraunces" POINT-SIZE="13" COLOR="#c8860a"><B>1</B></FONT></TD><TD WIDTH="7">&#8202;</TD><TD BGCOLOR="#fbeed2" ALIGN="CENTER" CELLPADDING="5"><FONT FACE="Space Grotesk" POINT-SIZE="12" COLOR="#16202c">Litio</FONT> <FONT FACE="Fraunces" POINT-SIZE="13" COLOR="#c8860a"><B>1</B></FONT></TD><TD WIDTH="7">&#8202;</TD><TD BGCOLOR="#fbeed2" ALIGN="CENTER" CELLPADDING="5"><FONT FACE="Space Grotesk" POINT-SIZE="12" COLOR="#16202c">Acero</FONT> <FONT FACE="Fraunces" POINT-SIZE="13" COLOR="#c8860a"><B>1</B></FONT></TD><TD WIDTH="7">&#8202;</TD><TD BGCOLOR="#fbeed2" ALIGN="CENTER" CELLPADDING="5"><FONT FACE="Space Grotesk" POINT-SIZE="12" COLOR="#16202c">Titanio</FONT> <FONT FACE="Fraunces" POINT-SIZE="13" COLOR="#c8860a"><B>1</B></FONT></TD><TD WIDTH="7">&#8202;</TD><TD BGCOLOR="#fbeed2" ALIGN="CENTER" CELLPADDING="5"><FONT FACE="Space Grotesk" POINT-SIZE="12" COLOR="#16202c">Cobre</FONT> <FONT FACE="Fraunces" POINT-SIZE="13" COLOR="#c8860a"><B>1</B></FONT></TD><TD WIDTH="7">&#8202;</TD></TR></TABLE></TD></TR><TR><TD HEIGHT="10">&#8202;</TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Space Grotesk" POINT-SIZE="12" COLOR="#6a7789">Solo 18 de los 37 objetos llegaron hasta aquí</FONT></TD></TR></TABLE>> ];
