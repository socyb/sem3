  /* ── El hallazgo ── */
  hallazgo [ pos="820,190!", fillcolor="#341a23", color="#ff5573", penwidth=2.5, margin="0.24,0.20", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD FIXEDSIZE="TRUE" WIDTH="620" HEIGHT="1"></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="IBM Plex Mono" POINT-SIZE="11" COLOR="#ff5573"><B>EL PUNTO CIEGO DEL RADAR</B></FONT></TD></TR><TR><TD HEIGHT="10">&#8202;</TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Fraunces" POINT-SIZE="19" COLOR="#eef3f9"><B>Lo que seguimos es software. Lo que traemos en la mano es materia.</B></FONT></TD></TR><TR><TD HEIGHT="4">&#8202;</TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Space Grotesk" POINT-SIZE="14" COLOR="#c6d3e2">&#8202;</FONT></TD></TR><TR><TD HEIGHT="4">&#8202;</TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Space Grotesk" POINT-SIZE="14" COLOR="#c6d3e2">32 de nuestros 39 radares apuntan a la inteligencia artificial. Y 32 de los 37 objetos que</FONT></TD></TR><TR><TD HEIGHT="4">&#8202;</TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Space Grotesk" POINT-SIZE="14" COLOR="#c6d3e2">dijimos usar todos los días son aparatos: un celular, unos audífonos, una laptop, un reloj.</FONT></TD></TR><TR><TD HEIGHT="4">&#8202;</TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Space Grotesk" POINT-SIZE="14" COLOR="#c6d3e2">Están hechos de aluminio, vidrio, plástico, litio, cobre, coltán y silicio, y alguien los arma</FONT></TD></TR><TR><TD HEIGHT="4">&#8202;</TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Space Grotesk" POINT-SIZE="14" COLOR="#c6d3e2">en algún lugar. Ese sector —electrónica, química, manufactura— lo seguimos 3 de 39.</FONT></TD></TR><TR><TD HEIGHT="4">&#8202;</TD></TR></TABLE>> ];

  /* ── Leyenda ── */
  leyenda [ pos="820,1660!", shape="plaintext", style="", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD ALIGN="CENTER"><FONT FACE="IBM Plex Mono" POINT-SIZE="11" COLOR="#8ea0b6">CADA CIFRA ES CUÁNTOS DE NOSOTROS ESCRIBIMOS ESO · PUNTEADO: LO QUE CASI NADIE MIRA · EN ROJO: EL HUECO</FONT></TD></TR></TABLE>> ];
