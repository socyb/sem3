CENTER" CELLPADDING="5"><FONT FACE="Space Grotesk" POINT-SIZE="12" COLOR="#eef3f9">Litio</FONT> <FONT FACE="Fraunces" POINT-SIZE="13" COLOR="#f2c257"><B>1</B></FONT></TD><TD WIDTH="7">&#8202;</TD><TD BGCOLOR="#332711" ALIGN="CENTER" CELLPADDING="5"><FONT FACE="Space Grotesk" POINT-SIZE="12" COLOR="#eef3f9">Acero</FONT> <FONT FACE="Fraunces" POINT-SIZE="13" COLOR="#f2c257"><B>1</B></FONT></TD><TD WIDTH="7">&#8202;</TD><TD BGCOLOR="#332711" ALIGN="CENTER" CELLPADDING="5"><FONT FACE="Space Grotesk" POINT-SIZE="12" COLOR="#eef3f9">Titanio</FONT> <FONT FACE="Fraunces" POINT-SIZE="13" COLOR="#f2c257"><B>1</B></FONT></TD><TD WIDTH="7">&#8202;</TD><TD BGCOLOR="#332711" ALIGN="CENTER" CELLPADDING="5"><FONT FACE="Space Grotesk" POINT-SIZE="12" COLOR="#eef3f9">Cobre</FONT> <FONT FACE="Fraunces" POINT-SIZE="13" COLOR="#f2c257"><B>1</B></FONT></TD><TD WIDTH="7">&#8202;</TD></TR></TABLE></TD></TR><TR><TD HEIGHT="10">&#8202;</TD></TR><TR><TD ALIGN="CENTER"><FONT FACE="Space Grotesk" POINT-SIZE="12" COLOR="#8ea0b6">Solo 18 de los 37 objetos llegaron hasta aquí</FONT></TD></TR></TABLE>> ];
